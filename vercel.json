{
  "headers": [
    {
      "source": "/(Video|video)/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!Video/|video/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
